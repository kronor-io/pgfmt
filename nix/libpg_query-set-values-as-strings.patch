diff --git a/src/postgres_deparse.c b/src/postgres_deparse.c
index 58401ad..1ed0fbd 100644
--- a/src/postgres_deparse.c
+++ b/src/postgres_deparse.c
@@ -1441,19 +1441,20 @@ static void deparseCommonFuncOptItem(DeparseState *state, DefElem *def_elem)
 
 // "NonReservedWord_or_Sconst" in gram.y
 //
-// Note since both identifiers and string constants are allowed here, we
-// currently always return an identifier, except:
-//
-// 1) when the string is empty (since an empty identifier can't be scanned)
-// 2) when the value is equal or larger than NAMEDATALEN (64+ characters)
+// Both identifiers and string constants are allowed here, and both parse to
+// the same String value. We write a bare word when the value needs no
+// quoting as an identifier (e.g. "plpgsql", "public"), and a string constant
+// otherwise (e.g. '50ms', '$user', 'UTC'): a double-quoted value would read as
+// an identifier, which it is not. A string constant is also used when the
+// string is empty (since an empty identifier can't be scanned) and when the
+// value is equal or larger than NAMEDATALEN (64+ characters), since an
+// identifier that long would be truncated.
 static void deparseNonReservedWordOrSconst(DeparseState *state, const char *val)
 {
-	if (strlen(val) == 0)
-		deparseAppendStringInfoString(state, "''");
-	else if (strlen(val) >= NAMEDATALEN)
-		deparseStringLiteral(state, val);
+	if (strlen(val) > 0 && strlen(val) < NAMEDATALEN && quote_identifier(val) == val)
+		deparseAppendStringInfoString(state, val);
 	else
-		deparseAppendStringInfoString(state, quote_identifier(val));
+		deparseStringLiteral(state, val);
 }
 
 // "func_as" in gram.y
@@ -9260,7 +9261,7 @@ static void deparseCreatePLangStmt(DeparseState *state, CreatePLangStmt *create_
 		deparseAppendStringInfoString(state, "TRUSTED ");
 
 	deparseAppendStringInfoString(state, "LANGUAGE ");
-	deparseNonReservedWordOrSconst(state, create_p_lang_stmt->plname);
+	deparseColId(state, create_p_lang_stmt->plname);
 	deparseAppendStringInfoChar(state, ' ');
 
 	deparseAppendStringInfoString(state, "HANDLER ");
