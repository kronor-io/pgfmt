cabal-version: 3.0
name:          pgfmt-lint
version:       0.1.0.0
synopsis:      The rules of docs/readability.md that a tool can check, for hopinion

common shared
  default-language: GHC2021
  ghc-options:
    -Wall
    -Werror=missing-signatures
    -Werror=incomplete-patterns

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    PgFmt.Lint
    PgFmt.Lint.Rule.NamedFields
    PgFmt.Lint.Rule.NamedTuples
    PgFmt.Lint.Rule.SmallWhere
    PgFmt.Lint.Syntax

  build-depends:
    , base
    , containers
    , ghc-lib-parser
    , hopinion
    , string-interpolate
    , syb
    , text

executable pgfmt-lint
  import:         shared
  hs-source-dirs: app
  main-is:        PgfmtLint.hs
  ghc-options:    -main-is PgfmtLint.main
  build-depends:
    , base
    , pgfmt-lint
