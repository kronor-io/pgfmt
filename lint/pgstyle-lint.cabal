cabal-version: 3.0
name:          pgstyle-lint
version:       0.1.0.0
synopsis:      The rules of docs/readability.md that a tool can check, for hopinion

common shared
  default-language: GHC2021
  ghc-options:
    -Wall
    -Werror=missing-signatures
    -Werror=incomplete-patterns

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    PgStyle.Lint
    PgStyle.Lint.Rule.NamedFields
    PgStyle.Lint.Rule.NamedTuples
    PgStyle.Lint.Rule.SmallWhere
    PgStyle.Lint.Syntax

  build-depends:
    , base
    , containers
    , ghc-lib-parser
    , hopinion
    , string-interpolate
    , syb
    , text

executable pgstyle-lint
  import:         shared
  hs-source-dirs: app
  main-is:        PgstyleLint.hs
  ghc-options:    -main-is PgstyleLint.main
  build-depends:
    , base
    , pgstyle-lint
