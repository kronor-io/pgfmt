packages: .

-- .hie files, which the lint (scripts/check lint) reads; editors' language
-- servers use them too.
package pgstyle
  ghc-options: -fwrite-ide-info

allow-newer:
  *:base,
  *:bytestring,
  *:containers,
  *:ghc-prim,
  *:template-haskell,
  *:text

index-state: hackage.haskell.org 2026-11-24T23:00:00Z
